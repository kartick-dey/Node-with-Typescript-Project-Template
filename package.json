{
    "name": "skeleton-of-node-with-typescript",
    "version": "1.0.0",
    "description": "Basic skeleton of project using node with typescript",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc && copyfiles .env docs/**/* dist",
        "watch:build": "tsc --watch",
        "watch:server": "nodemon",
        "dev": "npm run build && ts-node-dev --respawn --transpile-only src/server.ts",
        "start": "node dist/server.js"
    },
    "author": "Kartick Dey",
    "license": "ISC",
    "dependencies": {
        "axios": "^1.7.7",
        "body-parser": "^1.20.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.1",
        "express-openapi-validator": "^5.4.2",
        "path": "^0.12.7",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^10.0.0",
        "winston": "^3.15.0",
        "winston-daily-rotate-file": "^5.0.0",
        "yamljs": "^0.3.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/dotenv": "^6.1.1",
        "@types/express": "^5.0.0",
        "@types/node": "^22.8.5",
        "@types/swagger-ui-express": "^4.1.7",
        "@types/uuid": "^10.0.0",
        "@types/winston": "^2.4.4",
        "@types/yamljs": "^0.2.34",
        "copyfiles": "^2.4.1",
        "nodemon": "^3.1.7",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0"
    }
}
